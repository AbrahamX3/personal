{
  "name": "personal-website",
  "version": "1.0.0",
  "license": "MIT",
  "author": "AbrahamX3",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "concurrently --names \"lint,typecheck,format\" --prefix-colors \"yellow,blue,green\" \"pnpm run lint\" \"pnpm run typecheck\" \"pnpm run format:check\"",
    "lint": "oxlint src astro.config.mjs",
    "lint:fix": "oxlint --fix src astro.config.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify": "oxlint src astro.config.mjs && oxfmt --check . && astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/vercel": "11.0.10",
    "@fontsource/geist-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@umami/api-client": "^0.80.0",
    "astro": "7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "use-lanyard": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
