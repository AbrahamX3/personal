---
import "@fontsource/geist-sans";
import "~/styles/global.css";

const description =
  "Freelance full-stack developer in Mexicali, Mexico. TypeScript, web apps, Electron, Expo—plus C#/.NET and PHP when needed.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="title" content="Abraham | Freelance full-stack developer" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="typescript, freelance, full-stack, web developer, mexicali, electron, expo, astro, react"
    />
    <meta property="og:title" content="Abraham | Freelance full-stack developer" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://abraham.lat" />
    <meta property="og:site_name" content="Abraham" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en-US" />
    <meta property="og:image" content="/icon.webp" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Abraham's Avatar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Abraham | Freelance full-stack developer" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@x3_abe" />
    <meta name="twitter:creator" content="@x3_abe" />
    <meta name="twitter:site:id" content="3038180873" />
    <meta name="twitter:creator:id" content="3038180873" />
    <meta name="twitter:image" content="/icon.webp" />
    <link rel="icon" type="image/webp" href="/icon.webp" />
    <title>Abraham | Freelance full-stack developer</title>
    <script
      is:inline
      defer
      src={import.meta.env.UMAMI_SCRIPT_URL}
      data-website-id={import.meta.env.UMAMI_WEBSITE_ID}></script>
  </head>
  <body
    class="font-sans text-zinc-100 antialiased selection:bg-zinc-600/40 selection:text-white"
  >
    <slot />
  </body>
</html>
