---
import { Image } from "astro:assets";
import ProjectButton from "~/components/project-button.astro";
import GitHubIcon from "~/icons/github-icon.astro";
import { PROJECTS } from "~/lib/constants";
---

<section
  class="mx-auto flex w-full max-w-2xl flex-col items-stretch gap-y-8"
  aria-labelledby="projects-heading"
>
  <h2
    id="projects-heading"
    class="text-center text-xs font-medium uppercase tracking-widest text-zinc-500"
  >
    Projects
  </h2>
  <ul class="flex flex-col gap-y-10">
    {
      PROJECTS.map((project) => (
        <li class="flex flex-col gap-y-3 border-b border-zinc-800/80 pb-10 last:border-0 last:pb-0">
          <div class="flex bg-zinc-900/40 p-2 rounded-md flex-col gap-y-1 sm:flex-row sm:items-center sm:justify-between sm:gap-x-4">
            <div class="flex items-center gap-3">
              {project.logo ? (
                <Image
                  src={project.logo}
                  alt={project.name}
                  width={28}
                  height={28}
                  class="size-7 shrink-0 rounded-md object-cover"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              ) : null}
              <h3 class="text-base font-medium text-zinc-100">{project.name}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {project.private ? (
                <span class="rounded-md border border-zinc-800 bg-zinc-900/30 px-2 py-1 text-xs text-zinc-500">
                  Private
                </span>
              ) : (
                <>
                  {project.url?.website ? (
                    <ProjectButton name="Website" url={project.url.website}>
                      <svg
                        class="size-3.5 shrink-0 text-zinc-400"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                    </ProjectButton>
                  ) : null}
                  {project.url?.repository ? (
                    <ProjectButton name="GitHub" url={project.url.repository}>
                      <GitHubIcon />
                    </ProjectButton>
                  ) : null}
                </>
              )}
            </div>
          </div>
          <p class="text-sm text-pretty leading-relaxed text-zinc-400">{project.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {project.technologies.map((tech) => (
              <a
                href={tech.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-zinc-800/90 bg-zinc-950/40 px-2 py-0.5 text-[11px] text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-300"
              >
                {tech.name}
              </a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</section>
