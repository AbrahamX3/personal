---
interface Props {
  name: string;
  url: string;
  isPrivate?: boolean;
}

const { name, url, isPrivate = false } = Astro.props;
---

<a
  target="_blank"
  rel="noopener noreferrer"
  href={url}
  data-tooltip-target="tooltip-default"
  class="has-tooltip flex w-max items-center justify-center gap-2 rounded-md border border-zinc-700/80 bg-zinc-900/40 px-2.5 py-1 text-xs text-zinc-200 transition-colors hover:border-zinc-600 hover:bg-zinc-800/50"
>
  <slot />
  <span class="z-10">{name}</span>

  <div
    class="tooltip -mt-16 w-max rounded-md border border-zinc-600/80 bg-zinc-900/95 p-1.5 text-center text-[10px] text-zinc-400 shadow-lg backdrop-blur-sm"
  >
    {isPrivate ? "Private project" : "Opens in new tab"}
  </div>
</a>
