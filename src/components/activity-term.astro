---
interface Props {
  label: string;
  descriptionHtml: string;
}

const { label, descriptionHtml } = Astro.props;
---

<span class="group relative inline-block align-baseline" tabindex="0">
  <span
    class="cursor-help border-b border-dotted border-zinc-500/80 text-zinc-400 transition-colors group-hover:border-zinc-400 group-hover:text-zinc-300 group-focus-visible:border-zinc-400 group-focus-visible:text-zinc-300 group-focus-visible:outline-none"
  >
    {label}
  </span>
  <span
    class="pointer-events-none invisible absolute left-1/2 top-full z-50 -mt-0.5 block w-[min(20rem,calc(100vw-2rem))] min-w-48 -translate-x-1/2 rounded-md border border-zinc-700/90 bg-zinc-900/95 p-3 text-left text-[11px] leading-relaxed text-zinc-300 opacity-0 shadow-lg backdrop-blur-sm transition-[opacity,visibility] duration-150 group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:visible group-focus-within:opacity-100 [&_a]:font-medium [&_a]:text-zinc-200 [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:hover:text-white"
    role="tooltip"
    set:html={descriptionHtml}
  />
</span>
